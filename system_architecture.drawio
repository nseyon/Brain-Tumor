<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Glioma-Architecture" version="21.0.0"><diagram id="glioma_arch" name="Glioma Architecture"><mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" value="End-to-End System Architecture: 3D SwinMamba Dual &amp;amp; IS-MIM Self-Supervised Learning" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1600" height="40" as="geometry" /></mxCell><mxCell id="11" value="Unified Deep Learning Pipeline for Multi-Parametric MRI Ingestion, 3D Intra-Modality Masked Pre-training, Joint Tumor Segmentation &amp;amp; Glioma Grade Classification" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="1600" height="25" as="geometry" /></mxCell><mxCell id="100" value="&amp;lt;b&amp;gt;1. DATA INGESTION &amp;amp; SPLIT&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;BraTS 2023 Adult Glioma (1,251 Subjects)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;strokeWidth=2;rounded=1;arcSize=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="320" height="1250" as="geometry" /></mxCell><mxCell id="101" value="&amp;lt;b&amp;gt;Raw Multi-Parametric MRI (3D NIfTI)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• T1-Native (t1n.nii)&amp;lt;br&amp;gt;• T1-Contrast (t1c.nii)&amp;lt;br&amp;gt;• T2-Weighted (t2w.nii)&amp;lt;br&amp;gt;• T2-FLAIR (t2f.nii)&amp;lt;br&amp;gt;• Ground Truth (seg.nii)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="280" height="120" as="geometry" /></mxCell><mxCell id="102" value="&amp;lt;b&amp;gt;Deterministic SplitManager&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Train: 750 (60.0%) Subjects&amp;lt;br&amp;gt;• Val: 250 (20.0%) Subjects&amp;lt;br&amp;gt;• Test: 251 (20.1%) Subjects (Locked)&amp;lt;br&amp;gt;Seed=42 | SHA-256 Checksums" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="280" height="110" as="geometry" /></mxCell><mxCell id="103" value="&amp;lt;b&amp;gt;Preprocessing &amp;amp; Normalization&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;1. Non-Zero Percentile Clip [0.5, 99.5]&amp;lt;br&amp;gt;2. Foreground Z-Score: (x - μ) / σ&amp;lt;br&amp;gt;3. Spatial Center Crop/Pad → [4, 96, 96, 96]&amp;lt;br&amp;gt;4. Label Map: WT(1+2+3), TC(1+3), ET(3)&amp;lt;br&amp;gt;5. Grade Inference: HGG(1) vs LGG(0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=1.5;fontColor=#0f766e;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="280" height="140" as="geometry" /></mxCell><mxCell id="104" value="&amp;lt;b&amp;gt;Batch Ingestion Tensors&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;Image: [B, 4, 96, 96, 96]&amp;lt;br&amp;gt;Seg GT: [B, 3, 96, 96, 96]&amp;lt;br&amp;gt;Label GT: [B] (0 or 1)&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="280" height="90" as="geometry" /></mxCell><mxCell id="1001" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="101" target="102" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="1002" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="102" target="103" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="1003" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="103" target="104" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="200" value="&amp;lt;b&amp;gt;2. SELF-SUPERVISED PRE-TRAINING: INTRA-MODALITY MASKED IMAGE MODELING (IS-MIM)&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c084fc;fontColor=#6b21a8;strokeWidth=2;rounded=1;arcSize=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="1380" height="190" as="geometry" /></mxCell><mxCell id="201" value="&amp;lt;b&amp;gt;2a. 3D Token Partition&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Patch Size: 16³&amp;lt;br&amp;gt;96³ → 6×6×6 grid&amp;lt;br&amp;gt;216 tokens [B, 4, 16³, 216]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="220" height="110" as="geometry" /></mxCell><mxCell id="202" value="&amp;lt;b&amp;gt;2b. Intra-Modality Swap&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;p_swap = 0.5 (2 iterations)&amp;lt;br&amp;gt;T1 ↔ T1ce, T2 ↔ FLAIR&amp;lt;br&amp;gt;Learns invariant anatomy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="230" height="110" as="geometry" /></mxCell><mxCell id="203" value="&amp;lt;b&amp;gt;2c. 50% Block Masking&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Mask Ratio = 50%&amp;lt;br&amp;gt;108 / 216 tokens zeroed&amp;lt;br&amp;gt;Generates voxel_mask M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="160" width="220" height="110" as="geometry" /></mxCell><mxCell id="204" value="&amp;lt;b&amp;gt;2d. Detokenization&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Reconstruct to 3D volume&amp;lt;br&amp;gt;X_perturbed: [B, 4, 96³]&amp;lt;br&amp;gt;X_clean: [B, 4, 96³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="160" width="220" height="110" as="geometry" /></mxCell><mxCell id="205" value="&amp;lt;b&amp;gt;2e. Pre-train Objective&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Masked MSE Loss&amp;lt;br&amp;gt;L_MIM = Σ M⊙(X̂-X)² / Σ M&amp;lt;br&amp;gt;AdamW, lr=5e-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;fontColor=#9a3412;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="160" width="230" height="110" as="geometry" /></mxCell><mxCell id="2001" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333ea;strokeWidth=2;" edge="1" source="201" target="202" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="2002" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333ea;strokeWidth=2;" edge="1" source="202" target="203" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="2003" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333ea;strokeWidth=2;" edge="1" source="203" target="204" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="2004" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333ea;strokeWidth=2;" edge="1" source="204" target="205" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="300" value="&amp;lt;b&amp;gt;3. CORE DEEP LEARNING MODEL: 3D HYBRID SWINMAMBA DUAL &amp;amp; UNETR DECODER&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;strokeWidth=2;rounded=1;arcSize=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="1380" height="1030" as="geometry" /></mxCell><mxCell id="310" value="&amp;lt;b&amp;gt;3A. HYBRID 3D ENCODER (SwinTransformer + MambaSSM)&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#818cf8;fontColor=#3730a3;strokeWidth=1.5;rounded=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="380" width="500" height="950" as="geometry" /></mxCell><mxCell id="311" value="&amp;lt;b&amp;gt;Stem Downsampler&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Conv3D (4→48, k=7³, s=2, p=3) + BN + LeakyReLU + Dropout3D&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;Output: [B, 48, 48, 48, 48]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1;fontColor=#1e1b4b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="420" width="460" height="50" as="geometry" /></mxCell><mxCell id="312" value="&amp;lt;b&amp;gt;Stage 0: 3D Swin Transformer (Depth=2, Dims=48, Heads=3, Win=7³)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Block 0: Window Attention (W-MSA)&amp;lt;br&amp;gt;• Block 1: Shifted Window Attention (SW-MSA, shift=(3,3,3))&amp;lt;br&amp;gt;Norm + MlpChannel (48→96→48) → &amp;lt;b&amp;gt;Skip S0 [B, 48, 48³]&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#4f46e5;strokeWidth=1.5;fontColor=#312e81;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="490" width="460" height="80" as="geometry" /></mxCell><mxCell id="313" value="&amp;lt;b&amp;gt;Patch Merging 0→1&amp;lt;/b&amp;gt;: Conv3D (48→96, k=2³, s=2) → [B, 96, 24³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="590" width="460" height="30" as="geometry" /></mxCell><mxCell id="314" value="&amp;lt;b&amp;gt;Stage 1: 3D Swin Transformer (Depth=2, Dims=96, Heads=6, Win=7³)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Block 0: Window Attention (W-MSA)&amp;lt;br&amp;gt;• Block 1: Shifted Window Attention (SW-MSA, shift=(3,3,3))&amp;lt;br&amp;gt;Norm + MlpChannel (96→192→96) → &amp;lt;b&amp;gt;Skip S1 [B, 96, 24³]&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#4f46e5;strokeWidth=1.5;fontColor=#312e81;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="640" width="460" height="80" as="geometry" /></mxCell><mxCell id="315" value="&amp;lt;b&amp;gt;Patch Merging 1→2&amp;lt;/b&amp;gt;: Conv3D (96→192, k=2³, s=2) → [B, 192, 12³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="740" width="460" height="30" as="geometry" /></mxCell><mxCell id="316" value="&amp;lt;b&amp;gt;Stage 2: GSC + Tri-Directional Mamba SSM (Depth=2, Dims=192)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• GSC: Global Spatial Context Residual Convolutions (3×3×3 &amp;amp; 1×1×1)&amp;lt;br&amp;gt;• Tri-Directional Selective Scan: Axial (D→H→W) + Sagittal (W→D→H) + Coronal (H→W→D)&amp;lt;br&amp;gt;Norm + MlpChannel (192→384→192) → &amp;lt;b&amp;gt;Skip S2 [B, 192, 12³]&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="790" width="460" height="95" as="geometry" /></mxCell><mxCell id="317" value="&amp;lt;b&amp;gt;Patch Merging 2→3&amp;lt;/b&amp;gt;: Conv3D (192→384, k=2³, s=2) → [B, 384, 6³]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="905" width="460" height="30" as="geometry" /></mxCell><mxCell id="318" value="&amp;lt;b&amp;gt;Stage 3: Deepest Tri-Directional Mamba (Depth=2, Dims=384)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• GSC Spatial Prior + 3D SSM Continuous State Modeling&amp;lt;br&amp;gt;• Orthogonal Volumetric Sequences L = 6³ = 216 tokens&amp;lt;br&amp;gt;Output: &amp;lt;b&amp;gt;Deep Latents [B, 384, 6, 6, 6]&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="955" width="460" height="80" as="geometry" /></mxCell><mxCell id="3001" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="311" target="312" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3002" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="312" target="313" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3003" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="313" target="314" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3004" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="314" target="315" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3005" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="315" target="316" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3006" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="316" target="317" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3007" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" source="317" target="318" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="330" value="&amp;lt;b&amp;gt;3B. SKIP ENCODERS&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#38bdf8;fontColor=#0369a1;strokeWidth=1.5;rounded=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="200" height="950" as="geometry" /></mxCell><mxCell id="331" value="&amp;lt;b&amp;gt;enc_stem&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;4 → 48 dims&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;[B, 48, 96³]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="420" width="170" height="50" as="geometry" /></mxCell><mxCell id="332" value="&amp;lt;b&amp;gt;enc_stage0&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;48 → 48 dims&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;[B, 48, 48³]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="510" width="170" height="50" as="geometry" /></mxCell><mxCell id="333" value="&amp;lt;b&amp;gt;enc_stage1&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;96 → 96 dims&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;[B, 96, 24³]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="660" width="170" height="50" as="geometry" /></mxCell><mxCell id="334" value="&amp;lt;b&amp;gt;enc_stage2&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;192 → 192 dims&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;[B, 192, 12³]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="810" width="170" height="50" as="geometry" /></mxCell><mxCell id="335" value="&amp;lt;b&amp;gt;enc_bottleneck&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;384 → 768 dims&amp;lt;br&amp;gt;&amp;lt;font face='Consolas'&amp;gt;&amp;lt;b&amp;gt;[B, 768, 6³]&amp;lt;/b&amp;gt;&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=11;fontColor=#1e40af;" vertex="1" parent="1"><mxGeometry x="975" y="965" width="170" height="60" as="geometry" /></mxCell><mxCell id="350" value="&amp;lt;b&amp;gt;3C. UNETR DECODER + EV2 REFINEMENT&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#60a5fa;fontColor=#1e40af;strokeWidth=1.5;rounded=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="380" width="580" height="950" as="geometry" /></mxCell><mxCell id="354" value="&amp;lt;b&amp;gt;Decoder 4 (UnetrUpBlock3D)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ConvTranspose3D (768→192, k=2, s=2) ⊕ &amp;lt;b&amp;gt;skip_2 (192)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;EV2Block Fusion (384→192) → &amp;lt;font face='Consolas'&amp;gt;[B, 192, 12, 12, 12]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="960" width="540" height="65" as="geometry" /></mxCell><mxCell id="353" value="&amp;lt;b&amp;gt;Decoder 3 (UnetrUpBlock3D)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ConvTranspose3D (192→96, k=2, s=2) ⊕ &amp;lt;b&amp;gt;skip_1 (96)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;EV2Block Fusion (192→96) → &amp;lt;font face='Consolas'&amp;gt;[B, 96, 24, 24, 24]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="810" width="540" height="65" as="geometry" /></mxCell><mxCell id="352" value="&amp;lt;b&amp;gt;Decoder 2 (UnetrUpBlock3D)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ConvTranspose3D (96→48, k=2, s=2) ⊕ &amp;lt;b&amp;gt;skip_0 (48)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;EV2Block Fusion (96→48) → &amp;lt;font face='Consolas'&amp;gt;[B, 48, 48, 48, 48]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="660" width="540" height="65" as="geometry" /></mxCell><mxCell id="351" value="&amp;lt;b&amp;gt;Decoder 1 (UnetrUpBlock3D)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;ConvTranspose3D (48→48, k=2, s=2) ⊕ &amp;lt;b&amp;gt;skip_stem (48)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;EV2Block Fusion (96→48) → &amp;lt;font face='Consolas'&amp;gt;[B, 48, 96, 96, 96]&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="510" width="540" height="65" as="geometry" /></mxCell><mxCell id="3501" value="&amp;lt;b&amp;gt;EV2 Residual Refinement Block (Final Latent)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Squeeze-and-Excitation (SE) Channel Attention + Residual Conv&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Output: dec_out [B, 48, 96, 96, 96]&amp;lt;/b&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="540" height="60" as="geometry" /></mxCell><mxCell id="3054" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="354" target="353" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3053" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="353" target="352" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3052" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="352" target="351" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="3051" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" source="351" target="3501" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="400" value="&amp;lt;b&amp;gt;4. TASK HEADS &amp;amp; INFERENCE EVALUATION&amp;lt;/b&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;strokeWidth=2;rounded=1;arcSize=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1830" y="110" width="510" height="1250" as="geometry" /></mxCell><mxCell id="410" value="&amp;lt;b&amp;gt;HEAD 1: 3D Tumor Segmentation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;UnetOutBlock3D: Conv3D (48→3, k=1³)&amp;lt;br&amp;gt;Logits: [B, 3, 96³] → Sigmoid Probs&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;Channels:&amp;lt;/b&amp;gt; TC (Core), WT (Whole), ET (Enhancing)&amp;lt;br&amp;gt;&amp;lt;font color='#c2410c'&amp;gt;&amp;lt;b&amp;gt;Loss:&amp;lt;/b&amp;gt; SoftDice (1.3, 1.0, 1.5) + Focal (α=0.25, γ=2)&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1850" y="160" width="470" height="110" as="geometry" /></mxCell><mxCell id="420" value="&amp;lt;b&amp;gt;HEAD 2: Glioma Grade Classification&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Dual Global Pooling: GAP [B,768] + GMP [B,768]&amp;lt;br&amp;gt;Fused Vector: [B, 1536]&amp;lt;br&amp;gt;MLP: 1536 → 256 (Drop 0.4) → 128 (Drop 0.2) → 2&amp;lt;br&amp;gt;Logits: [B, 2] → Softmax [P(LGG), P(HGG)]&amp;lt;br&amp;gt;&amp;lt;font color='#c2410c'&amp;gt;&amp;lt;b&amp;gt;Loss:&amp;lt;/b&amp;gt; CrossEntropy(smoothing=0.05)&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1850" y="290" width="470" height="120" as="geometry" /></mxCell><mxCell id="430" value="&amp;lt;b&amp;gt;Total Multi-Task Fine-Tuning Loss:&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font face='Consolas' size='3'&amp;gt;&amp;lt;b&amp;gt;L_total = L_Dice + L_Focal + 0.5 · L_CrossEntropy&amp;lt;/b&amp;gt;&amp;lt;/font&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#9a3412;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1850" y="430" width="470" height="50" as="geometry" /></mxCell><mxCell id="440" value="&amp;lt;b&amp;gt;5. Clinical Post-Processing Pipeline&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;1. Sigmoid Thresholding (p &amp;gt; 0.5)&amp;lt;br&amp;gt;2. 3D Connected Component Analysis (scipy.ndimage):&amp;lt;br&amp;gt;   • WT clusters &amp;lt; 250 voxels removed&amp;lt;br&amp;gt;   • TC clusters &amp;lt; 150 voxels removed&amp;lt;br&amp;gt;   • ET clusters &amp;lt; 100 voxels removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1.5;fontColor=#047857;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1850" y="510" width="470" height="110" as="geometry" /></mxCell><mxCell id="450" value="&amp;lt;b&amp;gt;Quantitative Evaluation on Held-Out Test Set (251 Cases)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Segmentation: Dice Scores (WT, TC, ET, Mean), HD95 (mm)&amp;lt;br&amp;gt;• Classification: Accuracy, F1-Score, Precision, Recall, AUC-ROC&amp;lt;br&amp;gt;• Checkpoint Verification: finetune_best.pt&amp;lt;br&amp;gt;• NIfTI Binary Predictions: outputs/predictions/*.nii.gz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;fontColor=#065f46;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1850" y="640" width="470" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>